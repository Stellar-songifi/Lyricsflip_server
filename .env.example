JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRES_IN=7d
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=portable
DB_PASSWORD=dorcas
DB_NAME=lyricflip
PORT=4000

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/lyricsflip

# Frontend
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stellar / Soroban settlement
# ---------------------------------------------------------------------------
# Leave this file's defaults alone to run entirely off-chain: with
# STELLAR_SETTLEMENT_MODE=mock, wagers settle as Postgres rows and none of the
# other variables below are read. Every value marked "Required in stellar mode"
# is validated at boot, and the server refuses to start if one is missing or
# malformed — a bad contract ID surfaces as a failed boot rather than as a
# transaction that fails on-chain after funds have moved.

# How wagers settle: "mock" (Postgres balances, no network) or "stellar" (real
# Soroban contract invocations). Default: mock
STELLAR_SETTLEMENT_MODE=mock

# Which network to talk to: public | testnet | futurenet | standalone
# Default: testnet
STELLAR_NETWORK=testnet

# Who signs a player's stake transaction.
#   non-custodial — the backend returns unsigned XDR for the player's wallet
#                   (Freighter, xBull, Albedo) to sign. Default.
#   custodial     — the backend holds player keys and signs for them. Testnet
#                   demos only; boot fails if combined with STELLAR_NETWORK=public.
STELLAR_CUSTODY_MODE=non-custodial

# How long a player's unsigned stake transaction stays valid before the
# network rejects it, in seconds. If a player takes longer than this to sign,
# POST /game-sessions/:id/stake/transaction rebuilds a fresh one.
# Default: 180
# STELLAR_STAKE_TX_TIMEOUT_SECONDS=180

# How long a wager may sit AWAITING_STAKES — one player staked, the other
# never signed — before WagerRefundJob refunds it automatically and marks the
# session abandoned. In minutes.
# Default: 15
# WAGER_STAKE_DEADLINE_MINUTES=15

# Soroban JSON-RPC and Horizon endpoints. Both default to the public endpoints
# for STELLAR_NETWORK, so set them only to point at your own infrastructure or a
# standalone quickstart container.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Overrides the network passphrase implied by STELLAR_NETWORK. Needed only for
# a standalone/quickstart network started with a custom passphrase.
# STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Contract ID (C...) of the deployed lyricsflip-escrow contract.
# Required in stellar mode.
# STELLAR_ESCROW_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Contract ID (C...) of the LYRIC token — a Soroban token contract, or the
# Stellar Asset Contract address of a classic asset.
# Required in stellar mode.
# STELLAR_TOKEN_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Secret seed (S...) of the account that resolves wagers. The escrow contract
# accepts resolve/refund from this address and no other, so this key can pay out
# every open pot — keep it out of shared environments.
# Required in stellar mode.
# STELLAR_RESOLVER_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Master seed that per-player custodial keys are derived from, together with the
# user ID. Required when STELLAR_CUSTODY_MODE=custodial, unused otherwise.
# A leaked process dump exposes every derived account, so replace the env key
# store with a KMS-backed IKeyStore before this holds real value.
# STELLAR_CUSTODIAL_MASTER_SEED=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Home domain advertised in SEP-10 challenges; must match the domain wallets
# reach this API on. Default: localhost
STELLAR_WEB_AUTH_DOMAIN=localhost

# Secret seed (S...) that signs SEP-10 challenges. Kept separate from the
# resolver key so either can be rotated alone. Falls back to
# STELLAR_RESOLVER_SECRET, then to an ephemeral key that is regenerated on every
# restart — fine locally, but it invalidates outstanding challenges, so set this
# before deploying.
# STELLAR_WEB_AUTH_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
